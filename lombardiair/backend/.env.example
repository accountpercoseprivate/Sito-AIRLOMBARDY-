# URL del tuo progetto Supabase (Project Settings > API)
SUPABASE_URL=

# Chiave anonima pubblica (per chiamate standard)
SUPABASE_ANON_KEY=

# Chiave Service Role (OBBLIGATORIA lato backend per bypassare RLS nelle logiche server sicure)
SUPABASE_SERVICE_ROLE_KEY=
# Origini permesse da CORS (separate da virgola)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000